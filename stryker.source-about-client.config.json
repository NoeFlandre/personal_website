{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/features/about/client/**/*.js", "src/features/about/utils/**/*.js"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/run-source-mutation-tests.mjs"
  },
  "coverageAnalysis": "off",
  "cleanTempDir": "always",
  "ignorePatterns": [
    ".astro/**",
    ".stryker-tmp/**",
    "coverage/**",
    "crap-report/**",
    "dist/**",
    "output/**",
    "public/assets/**",
    "public/generated/**",
    "reports/**"
  ],
  "concurrency": 4,
  "timeoutFactor": 5,
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
