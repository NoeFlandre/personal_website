{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": [
    "src/features/about/utils/aboutMap.js",
    "src/features/blog/utils/getAdjacentEntries.js"
  ],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/about-map-regression.test.mjs tests/adjacent-posts.test.mjs"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "coverage/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "coverage/mutation/mutation.json"
  },
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
