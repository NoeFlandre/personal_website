{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "mutate": ["src/content.config.ts"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test tests/mutation-content-suite.test.mjs"
  },
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutFactor": 5,
  "reporters": ["clear-text", "progress"],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  }
}
