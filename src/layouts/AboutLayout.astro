---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import aboutOutlineUrl from "@/features/about/client/aboutOutline.js?url";
import { SITE } from "@/site-config.js";
import Layout from "./Layout.astro";

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;

const outlineLinks = [
  { href: "#about-intro", label: "About" },
  { href: "#journey-map", label: "Journey Map" },
  { href: "#github-activity", label: "GitHub Activity" },
  { href: "#recommendations", label: "Recommendations" },
  { href: "#publications", label: "Publications" },
  { href: "#experience", label: "Experience" },
  { href: "#education", label: "Education" },
  { href: "#projects", label: "Projects" },
  { href: "#awards", label: "Awards" },
  { href: "#volunteering", label: "Volunteering" },
];
---

<Layout title={`${frontmatter.title} | ${SITE.title}`} description={frontmatter.description}>
  <Header />
  <main
    id="main-content"
    class="mx-auto mt-8 w-full max-w-3xl px-4 pb-12"
    data-about-outline-root
  >
    <details class="about-outline-mobile" data-about-outline-mobile>
      <summary class="about-outline-mobile__summary">Jump To Section</summary>
      <ul class="about-outline-mobile__list">
        {outlineLinks.map((link) => (
          <li>
            <a href={link.href} class="about-outline__link" data-outline-link>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </details>

    <section id="about" class="about-content prose mb-28 max-w-3xl prose-img:border-0">
      <h1 class="text-2xl tracking-wider sm:text-3xl">{frontmatter.title}</h1>
      <slot />
    </section>
  </main>
  <Footer />
</Layout>

<script is:inline type="module" data-astro-rerun define:vars={{ aboutOutlineUrl }}>
  import(aboutOutlineUrl).then(({ initAboutOutline }) => initAboutOutline());
</script>

<style>
  .about-outline {
    position: sticky;
    top: 5.5rem;
    border-left: 2px solid color-mix(in srgb, var(--border) 78%, transparent);
    padding-left: 0.85rem;
  }

  .about-outline__label {
    margin: 0 0 0.7rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--foreground) 62%, transparent);
  }

  .about-outline__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  .about-outline__link {
    display: inline-flex;
    width: 100%;
    border-radius: 0.4rem;
    padding: 0.28rem 0.45rem;
    color: color-mix(in srgb, var(--foreground) 85%, transparent);
    text-decoration: none;
    transition: background-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .about-outline__link:hover {
    color: var(--foreground);
    background: color-mix(in srgb, var(--muted) 82%, transparent);
    transform: translateX(2px);
  }

  .about-outline__link[data-active="true"] {
    color: var(--background);
    background: var(--accent);
    font-weight: 700;
  }

  .about-outline-mobile {
    margin-bottom: 1rem;
    border: 1px solid color-mix(in srgb, var(--border) 75%, transparent);
    border-radius: 0.7rem;
    background: color-mix(in srgb, var(--background) 90%, var(--muted));
    overflow: hidden;
  }

  .about-outline-mobile__summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
    padding: 0.7rem 0.9rem;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .about-outline-mobile__summary::-webkit-details-marker {
    display: none;
  }

  .about-outline-mobile__summary::after {
    content: "▾";
    float: right;
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .about-outline-mobile[open] .about-outline-mobile__summary::after {
    content: "▴";
  }

  .about-outline-mobile__list {
    margin: 0;
    padding: 0.25rem 0.6rem 0.7rem;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  .about-content :where(section) {
    margin-left: 0;
    margin-right: 0;
    max-width: none;
    padding-left: 0;
    padding-right: 0;
  }

  .about-content :where(img, svg, canvas, iframe) {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 640px) {
    .about-outline-mobile {
      margin-bottom: 0.85rem;
    }

    .about-outline-mobile__summary {
      padding: 0.65rem 0.8rem;
      font-size: 0.84rem;
    }

    .about-outline-mobile__list {
      padding: 0.2rem 0.45rem 0.55rem;
      gap: 0.2rem;
    }

    .about-outline__link {
      padding: 0.24rem 0.4rem;
      font-size: 0.84rem;
    }
  }
</style>
