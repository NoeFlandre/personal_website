---
import StaticRedirect from "@/components/StaticRedirect.astro";
import { SITE } from "@/site-config.js";

const ArchivePage = SITE.showArchives
  ? (await import("../../features/blog/components/ArchivesPage.astro")).default
  : undefined;
---

{ArchivePage ? <ArchivePage /> : <StaticRedirect from="/archives" to="/404" lang={SITE.lang} />}
