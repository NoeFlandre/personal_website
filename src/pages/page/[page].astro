	---
	import { getCollection } from "astro:content";
	import type { GetStaticPathsOptions } from "astro";
		import getSortedPosts from "@/features/blog/utils/getSortedPosts";
		import FormattedDate from "../../components/FormattedDate.astro";
		import Footer from "../../components/Footer.astro";
		import Header from "../../components/Header.astro";
		import Pagination from "../../components/Pagination.astro";
		import { SITE } from "../../site-config.js";
		import Layout from "../../layouts/Layout.astro";
		import { getPath } from "@/features/blog/utils/getPath";

	export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	  const allPosts = await getCollection("blog");
	  const sortedPosts = getSortedPosts(allPosts);

  return paginate(sortedPosts, { pageSize: SITE.postPerIndex });
}

const { page } = Astro.props;
const { data: posts, currentPage, lastPage } = page;
---

<Layout title={`Page ${currentPage} | ${SITE.title}`} description={SITE.desc}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 py-8">
    <h1 class="text-4xl font-bold tracking-tight mb-10">Latest Posts</h1>

    <div class="space-y-12">
      {
        posts.map((post) => (
          <article class="border-b border-border pb-8 last:border-0">
            <h2 class="text-2xl font-semibold leading-tight mb-2">
	              <a href={getPath(post.id, post.filePath)} class="hover:text-primary">
                {post.data.title}
              </a>
            </h2>

	            <div class="flex items-center text-sm text-muted-foreground mb-4">
	              <FormattedDate date={post.data.pubDatetime} />
	            </div>

            {post.data.description && (
              <p class="text-muted-foreground mb-4">{post.data.description}</p>
            )}

            <div>
              <a
	                href={getPath(post.id, post.filePath)}
                class="text-primary font-medium hover:underline"
              >
                Read more →
              </a>
            </div>
          </article>
        ))
      }
    </div>

    <Pagination {page} />
  </main>
  <Footer />
</Layout>
