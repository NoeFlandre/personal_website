---
import {
  type BlogPostingData,
  buildStructuredData,
  type StructuredData,
  serializeStructuredData,
} from "@/utils/structuredData";

export interface Props {
  type: "BlogPosting" | "Person" | "WebSite";
  data?: BlogPostingData;
}

const props = Astro.props;
let structuredData: StructuredData;

if (props.type === "BlogPosting") {
  if (!props.data) {
    throw new Error("BlogPosting structured data requires post data");
  }
  structuredData = buildStructuredData(props.type, props.data);
} else {
  structuredData = buildStructuredData(props.type);
}
---

<script
  is:inline
  type="application/ld+json"
  set:html={serializeStructuredData(structuredData)}
/>
