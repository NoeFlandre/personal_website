---
import {
  CAREER_TIMELINE_AWARDS,
  CAREER_TIMELINE_EDUCATION,
  CAREER_TIMELINE_EXPERIENCE,
  CAREER_TIMELINE_HUMANITARIAN_IMPACT,
  CAREER_TIMELINE_PROJECTS,
  CAREER_TIMELINE_PUBLICATIONS,
  type TimelineItem,
} from "../data/careerTimelineData.ts";

interface TimelineSection {
  id: string;
  heading: string;
  items: TimelineItem[];
  titleClass: string;
  subtitleInTitle?: boolean;
  subtitleInDescription?: boolean;
  descriptionClass?: string;
  detailsClass?: string;
}

const SECTIONS: TimelineSection[] = [
  {
    id: "publications",
    heading: "Publications",
    items: CAREER_TIMELINE_PUBLICATIONS,
    titleClass: "text-lg font-bold leading-tight",
    subtitleInDescription: true,
    descriptionClass: "text-base text-foreground/80 mt-1",
  },
  {
    id: "experience",
    heading: "Experience",
    items: CAREER_TIMELINE_EXPERIENCE,
    titleClass: "text-xl font-bold leading-tight",
    subtitleInTitle: true,
    descriptionClass: "text-base font-medium text-foreground/80 mb-2 italic",
    detailsClass: "list-disc list-outside ml-4 space-y-1 text-base text-foreground/80",
  },
  {
    id: "education",
    heading: "Education",
    items: CAREER_TIMELINE_EDUCATION,
    titleClass: "text-xl font-bold leading-tight",
    subtitleInTitle: true,
    descriptionClass: "text-base text-foreground/80 mb-2",
    detailsClass: "list-dash list-outside ml-4 space-y-1 text-base text-foreground/80",
  },
  {
    id: "projects",
    heading: "Projects",
    items: CAREER_TIMELINE_PROJECTS,
    titleClass: "text-xl font-bold leading-tight",
    descriptionClass: "text-base text-foreground/80 mt-2",
  },
  {
    id: "awards",
    heading: "Awards",
    items: CAREER_TIMELINE_AWARDS,
    titleClass: "text-xl font-bold leading-tight",
    detailsClass: "list-disc list-outside ml-4 space-y-1 text-base text-foreground/80",
  },
  {
    id: "volunteering",
    heading: "Volunteering",
    items: CAREER_TIMELINE_HUMANITARIAN_IMPACT,
    titleClass: "text-xl font-bold leading-tight",
    subtitleInTitle: true,
    descriptionClass: "text-base font-medium text-foreground/80 mb-2 italic",
    detailsClass: "list-disc list-outside ml-4 space-y-1 text-base text-foreground/80",
  },
];

const timelineTitle = (item: TimelineItem, section: TimelineSection) =>
  section.subtitleInTitle
    ? `${item.title} ${item.subtitle ? `— ${item.subtitle}` : ""}`
    : item.title;
---

<div class="timeline-sections space-y-16 mt-12 mb-16">
  {SECTIONS.map((section) => (
    <section id={section.id} class="!p-0 !m-0 scroll-mt-24">
      <h2 class="text-2xl font-bold mb-8 border-b border-border pb-2 italic">{section.heading}</h2>
      <div class="relative border-l-2 border-border ml-3 md:ml-4 space-y-12">
        {section.items.map((item) => (
          <div class="relative pl-8">
            <div class="absolute -left-[11px] top-1.5 w-5 h-5 rounded-full bg-background border-4 border-accent"></div>
            <div class="flex flex-col md:flex-row md:justify-between md:items-start gap-1">
              <h3 class={section.titleClass}>
                {item.link ? (
                  <a href={item.link} target="_blank" rel="noopener noreferrer" class="hover:text-accent underline decoration-accent/30 underline-offset-4">
                    {timelineTitle(item, section)}
                  </a>
                ) : (
                  timelineTitle(item, section)
                )}
              </h3>
              <span class="text-sm font-semibold text-accent whitespace-nowrap">{item.year}</span>
            </div>
            {item.location && <p class="text-sm text-foreground/50 italic mb-2">{item.location}</p>}
            {section.subtitleInDescription ? (
              <p class={section.descriptionClass}>
                <span set:html={item.description ?? ""} />
                <span class="italic"> {item.subtitle}</span>
              </p>
            ) : (
              item.description && <p class={section.descriptionClass}>{item.description}</p>
            )}
            {item.body && <p class="text-base text-foreground/80 mb-2" set:html={item.body} />}
            {item.details && (
              <ul class={section.detailsClass}>
                {item.details.map((detail) => <li set:html={detail} />)}
              </ul>
            )}
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  .list-dash {
    list-style-type: "- ";
  }
</style>
