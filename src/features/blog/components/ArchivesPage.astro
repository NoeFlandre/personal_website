---
import { getCollection } from "astro:content";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import ArchiveGroups from "@/features/blog/components/ArchiveGroups.astro";
import { getArchiveGroups } from "@/features/blog/utils/getArchiveGroups";
import Layout from "@/layouts/Layout.astro";
import { SITE } from "@/site-config.js";

const archiveGroups = getArchiveGroups(await getCollection("blog"));
---

<Layout title={`Archives | ${SITE.title}`}>
  <Header />
  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-4">
    <h1 class="text-2xl font-semibold sm:text-3xl mt-8">Archives</h1>
    <p class="mt-2 mb-6 italic">Browse all posts by year and month</p>
    <ArchiveGroups groups={archiveGroups} />
  </main>
  <Footer />
</Layout>
