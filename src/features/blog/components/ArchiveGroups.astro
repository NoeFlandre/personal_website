---
import Card from "@/components/Card.astro";
import { countArchivePosts, MONTH_NAMES } from "@/features/blog/utils/archivePresentation";
import type { ArchiveYearGroup } from "@/features/blog/utils/getArchiveGroups";

interface Props {
  groups: ArchiveYearGroup[];
}

const { groups } = Astro.props;
---

{
  groups.map((yearGroup) => (
    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-6 border-b border-accent pb-2">
        {" "}{yearGroup.year}{" "}
        <sup class="text-sm ml-1">{countArchivePosts(yearGroup.months)}</sup>
      </h2>
      {yearGroup.months.map((monthGroup) => (
        <div class="mt-8">
          <h3 class="text-xl font-bold mb-4">
            {" "}{MONTH_NAMES[monthGroup.month - 1]}{" "}
            <sup class="text-sm ml-1">{monthGroup.posts.length}</sup>
          </h3>
          <ul>
            {monthGroup.posts.map((data) => <Card {...data} />)}
          </ul>
        </div>
      ))}
    </div>
  ))
}
