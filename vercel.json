{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/posts/:slug",
      "permanent": true
    },
    {
      "source": "/blog/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/posts/:slug",
      "permanent": true
    },
    {
      "source": "/blog/:slug([^\\/]+)$",
      "destination": "/posts/:slug",
      "permanent": true
    },
    {
      "source": "/categories/:category(.*)",
      "destination": "/tags/:category",
      "permanent": true
    },
    { "source": "/tag/:tag", "destination": "/tags/:tag", "permanent": true },
    {
      "source": "/20:year/:month/:day/:slug(.*)",
      "destination": "/posts/:slug",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/posts",
      "permanent": true
    },
    {
      "source": "/blog/:path*",
      "destination": "/posts/:path*",
      "permanent": true
    },
    {
      "source": "/posts/design-of-experiments",
      "destination": "/posts/2026/design-of-experiments",
      "permanent": true
    },
    {
      "source": "/posts/design-of-experiments.md",
      "destination": "/posts/2026/design-of-experiments.md",
      "permanent": true
    },
    {
      "source": "/posts/osm-data-analysis",
      "destination": "/posts/2026/osm-data-analysis",
      "permanent": true
    },
    {
      "source": "/posts/osm-data-analysis.md",
      "destination": "/posts/2026/osm-data-analysis.md",
      "permanent": true
    },
    {
      "source": "/posts/monopoly",
      "destination": "/posts/2026/monopoly",
      "permanent": true
    },
    {
      "source": "/posts/monopoly.md",
      "destination": "/posts/2026/monopoly.md",
      "permanent": true
    },
    {
      "source": "/posts/describe-place-on-earth-part1-wikidata",
      "destination": "/posts/2026/describe-place-on-earth-part1-wikidata",
      "permanent": true
    },
    {
      "source": "/posts/describe-place-on-earth-part1-wikidata.md",
      "destination": "/posts/2026/describe-place-on-earth-part1-wikidata.md",
      "permanent": true
    },
    {
      "source": "/posts/distilling_abms",
      "destination": "/posts/2026/distilling_abms",
      "permanent": true
    },
    {
      "source": "/posts/distilling_abms.md",
      "destination": "/posts/2026/distilling_abms.md",
      "permanent": true
    },
    {
      "source": "/posts/editor-pick-empathy-simulation",
      "destination": "/posts/2026/editor-pick-empathy-simulation",
      "permanent": true
    },
    {
      "source": "/posts/editor-pick-empathy-simulation.md",
      "destination": "/posts/2026/editor-pick-empathy-simulation.md",
      "permanent": true
    },
    {
      "source": "/posts/first-review",
      "destination": "/posts/2026/first-review",
      "permanent": true
    },
    {
      "source": "/posts/first-review.md",
      "destination": "/posts/2026/first-review.md",
      "permanent": true
    },
    {
      "source": "/posts/georeasoner",
      "destination": "/posts/2026/georeasoner",
      "permanent": true
    },
    {
      "source": "/posts/georeasoner.md",
      "destination": "/posts/2026/georeasoner.md",
      "permanent": true
    },
    {
      "source": "/posts/giving-agents-hands",
      "destination": "/posts/2026/giving-agents-hands",
      "permanent": true
    },
    {
      "source": "/posts/giving-agents-hands.md",
      "destination": "/posts/2026/giving-agents-hands.md",
      "permanent": true
    },
    {
      "source": "/posts/how2bench",
      "destination": "/posts/2026/how2bench",
      "permanent": true
    },
    {
      "source": "/posts/how2bench.md",
      "destination": "/posts/2026/how2bench.md",
      "permanent": true
    },
    {
      "source": "/posts/hugging-face-language-tags",
      "destination": "/posts/2026/hugging-face-language-tags",
      "permanent": true
    },
    {
      "source": "/posts/hugging-face-language-tags.md",
      "destination": "/posts/2026/hugging-face-language-tags.md",
      "permanent": true
    },
    {
      "source": "/posts/joining_evergreen",
      "destination": "/posts/2026/joining_evergreen",
      "permanent": true
    },
    {
      "source": "/posts/joining_evergreen.md",
      "destination": "/posts/2026/joining_evergreen.md",
      "permanent": true
    },
    {
      "source": "/posts/starting-youtube-channel",
      "destination": "/posts/2026/starting-youtube-channel",
      "permanent": true
    },
    {
      "source": "/posts/starting-youtube-channel.md",
      "destination": "/posts/2026/starting-youtube-channel.md",
      "permanent": true
    },
    {
      "source": "/posts/survival_guide_in_ai",
      "destination": "/posts/2026/survival_guide_in_ai",
      "permanent": true
    },
    {
      "source": "/posts/survival_guide_in_ai.md",
      "destination": "/posts/2026/survival_guide_in_ai.md",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^(?!(noeflandre\\.com|www\\.noeflandre\\.com|.*\\.vercel\\.app|.*\\.friendship\\.dev|.*\\.amantus\\.dev|.*\\.sweetistics\\.com)).*$"
        }
      ],
      "destination": "https://noeflandre.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/(about|archives|posts)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "destination": "/$1.md"
    },
    {
      "source": "/posts/:path*",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?i).*text/markdown.*"
        }
      ],
      "destination": "/posts/:path*.md"
    }
  ],
  "headers": [
    {
      "source": "/(.*).md",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/(|about|archives|posts|posts/.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://noeflandre.com https://*.vercel.app https://*.sweetistics.com https://platform.twitter.com https://syndication.twitter.com https://player.vimeo.com https://vimeo.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://noeflandre.com https://*.vercel.app https://*.sweetistics.com https://platform.twitter.com https://cdn.syndication.twimg.com https://player.vimeo.com https://vercel.live https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://noeflandre.com https://*.vercel.app https://*.sweetistics.com https://platform.twitter.com; img-src 'self' data: https: blob: https://ghchart.rshah.org; font-src 'self' https://noeflandre.com https://*.vercel.app https://*.sweetistics.com; connect-src 'self' https://noeflandre.com https://*.vercel.app https://*.sweetistics.com https://platform.twitter.com https://player.vimeo.com https://vimeo.com https://vitals.vercel-insights.com https://va.vercel-scripts.com; media-src 'self' https://noeflandre.com https://*.vercel.app https://*.sweetistics.com https://player.vimeo.com https://vimeo.com; object-src 'none'; frame-ancestors 'none'; frame-src https://platform.twitter.com https://syndication.twitter.com https://player.vimeo.com https://vercel.live https://www.youtube.com https://youtube.com https://*.youtube.com https://www.youtube-nocookie.com https://*.youtube-nocookie.com; worker-src 'self' blob:"
        }
      ]
    }
  ]
}
